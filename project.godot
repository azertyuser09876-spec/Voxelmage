; Fichier de configuration du projet VoxelMage
config_version=5

[application]

config/name="VoxelMage"
config/version="1.0.0"
config/description="Jeu de survie voxel 3D avec magie destructrice et multijoueur integre."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/textures/icon.png"
boot_splash/bg_color=Color(0.05, 0.05, 0.09, 1)
boot_splash/image="res://assets/textures/icon.png"

[autoload]

Boot="*res://scripts/game/Boot.gd"
Net="*res://scripts/net/Net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/vsync/vsync_mode=1

[layer_names]

3d_physics/layer_1="Monde"
3d_physics/layer_2="Joueurs"
3d_physics/layer_3="Mobs"
3d_physics/layer_4="Projectiles"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=26.0

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.3, 0.52, 0.92, 1)

[threads]

worker_pool/max_threads=4
